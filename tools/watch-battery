#!/bin/sh
#description: display a warning when the system is running out of energy
#             suspend|hibernate if no manual action is taken, power off if that fails
#usage: watch-battery

#minos runs it every minute as the user of the session, from the user timer watch-battery.timer
#(systemd --user, enabled for every user): it reads that user's config and acts as that user

PROGNAME="$(basename "${0}")"

PATH=/bin:/usr/bin:/sbin:/usr/sbin

_usage() {
    printf "%s\\n" "Usage: ${PROGNAME}"
    printf "%s\\n" "This program should be run every minute, as minos' user timer watch-battery.timer does"
}

_die() {
    [ -z "${1}" ] || printf "%s\\n" "${*}" >&2
    _usage >&2; exit 1
}

_notify() {
    [ -z "${1}" ] && return 1

    if [ X"${TERM}" = X"linux" ] || [ -z "${TERM}" ]; then
        kill -9 $(pgrep notify-osd) >/dev/null 2>&1
        if ! DISPLAY=${DISPLAY:-:0} notify-send -t 1000 "${1}" "${2}"; then
            if command -v gxmessage >/dev/null 2>&1; then
                DISPLAY=${DISPLAY:-:0} gxmessage -fn "Monaco 9" -buttons OK "${1}${2:+: ${2}}"
            else
                DISPLAY=${DISPLAY:-:0} LC_ALL=C.UTF-8 xmessage -xrm '*international: true' -xrm '*fontSet: -misc-fixed-medium-r-normal--13-*-*-*-*-*-*-*' -bg black -fg '#c7c1cc' -buttons OK "${1}${2:+: ${2}}"
            fi
        fi
    else
        if [ -z "${2}" ]; then
            printf "%s\\n" "${1}"
        else
            printf "%s: %s\\n" "${1}" "${2}"
        fi
    fi
}

_act() {
    #run the command for a minute at most; on failure, why in _act__error, without quotes,
    #which _notify cannot pass. Its errors go to a file: a menu it leaves open would hold a
    #pipe open; and the lock it may leave (dmenu-session) does not keep ours. The file is
    #mktemp's, never a fixed name in the shared temporary directory, which any user can plant
    #first. Without one the action still runs, its errors unread. From the timer (systemd sets
    #INVOCATION_ID) the command runs in a scope of its own: systemd ends this service with
    #every process in it, and the lock dmenu-session leaves on the screen must outlive it
    if _act__errfile="$(mktemp)"; then
        _act__err="${_act__errfile}"
    else
        _act__errfile=""; _act__err="/dev/null"
    fi
    if [ -n "${INVOCATION_ID}" ]; then
        timeout 60 systemd-run --user --scope --quiet --collect -- "${@}" >/dev/null 2>"${_act__err}" 9>&-
    else
        timeout 60 "${@}" >/dev/null 2>"${_act__err}" 9>&-
    fi
    _act__status="${?}"
    if [ -n "${_act__errfile}" ]; then
        _act__error="$(tr '\n' ' ' < "${_act__errfile}" | tr -d "'\"")"
        rm -f "${_act__errfile}"
    else
        _act__error="its errors were lost, mktemp failed"
    fi
    [ "${_act__status}" = "124" ] && _act__error="still running after a minute"
    return "${_act__status}"
}

_valid_batt_values() {
    if [ -z "${1}" ]; then
        return 1
    else
        _vbv__result="$(printf "%s\\n" "${1}" | awk '{ gsub(/^[ \t]+|[ \t]+$/, ""); print $1}')"
        while [ "${_vbv__result}" ]; do
            _vbv__option="${_vbv__result%%,*}"
            if ! printf "%s\\n" "${_vbv__option}" | grep -v "[^0-9]" >/dev/null; then
                return 1
            fi
            [ X"${_vbv__result}" = X"${_vbv__option}" ] && _vbv__result='' \
                || _vbv__result="${_vbv__result#*,}"
        done
        printf "%s\\n" "${1}"
    fi
}

_sort_batt_values() {
    if [ -z "${1}" ]; then
        return 1
    else
        _sbv__result="$(printf "%s\\n" "${1}" | awk '{ gsub(/^[ \t]+|[ \t]+$/, ""); print $1}')"
        _sbv__result="$(printf "%s\\n" "${_sbv__result}" | tr "," "\n" | sort -n |tr "\n" ",")"
        printf "%s\\n" "${_sbv__result%,}"
    fi
}

for arg in "${@}"; do #parse options
    case "${arg}" in
        --) shift; break ;;
        -h|--help) _usage && exit ;;
        -*) _die "${PROGNAME}: unrecognized option '${arg}'" ;;
    esac
done

#the battery key names the program that watches the battery, this one by default: a config without the
#key, or with it commented out, leaves the watch on, never an exec of an empty name
bin="$(minos-config battery 2>/dev/null | awk '{print $1}')"
case "${bin}" in
      no|NO|No|nO|false|disabled) exit ;;
    ''|watch-battery) :          ;;
                *) exec "${bin}" ;;
esac

#the notifications and the action reach the user's X session by its display, which the user's
#systemd does not know (the session bus is dbus-launch's, not systemd's): logind does, as the
#display of this user's graphical session; notify-send finds the session bus from the display
if [ -z "${DISPLAY}" ]; then
    display_session="$(loginctl show-user "$(id -u)" -p Display --value 2>/dev/null)"
    [ -z "${display_session}" ] || \
        DISPLAY="$(loginctl show-session "${display_session}" -p Display --value 2>/dev/null)"
    [ -z "${DISPLAY}" ] || export DISPLAY
fi

#the lock and the last warning given, in the user's runtime directory, private to the user
rundir="${XDG_RUNTIME_DIR:-${HOME}}"

exec 9>"${rundir}/${PROGNAME}".lock
if ! flock -n 9 ; then
    _notify "${PROGNAME}: another instance is running";
    exit 1
fi

if [ ! -f "$(command -v notify-send)" ] || [ ! -f "$(command -v acpi)" ]; then
    _notify  "Error" "install 'acpi' and 'notify-send' to run this program"
    exit 1
fi

#=====VARS=====
#current battery status (Charging/Discharging/AC/Unknown)
stat="$(acpi -b | awk '{sub(",", ""); print $3}')"
#battery percentage
batt_current="$(acpi -b |awk '{if ($0 ~ "%,") sub("%,", ""); else sub("%", ""); print $4}')"
batt_last_seen="$(cat "${rundir}/${PROGNAME}".last 2>/dev/null)"
batt_at="$(minos-config battery-alerts 2>/dev/null)"
[ -z "$(_valid_batt_values "${batt_at}")" ] && batt_at="$(minos-config battery-alerts 2>/dev/null)"
[ -z "$(_valid_batt_values "${batt_at}")" ] && batt_at="15,10,7,5"
batt_at="$(_sort_batt_values "${batt_at}")"

action="$(minos-config battery-action 2>/dev/null)"
if [ -z "${action}" ]; then
    if command -v "dmenu-session" >/dev/null 2>&1; then
        action="$(command -v "dmenu-session") hibernate"
    else
        action="$(minos-config hibernate 2>/dev/null)"
        [ -z "${action}" ] && action="systemctl hibernate"
    fi
fi
#=============

if [ X"${stat}" = X"Discharging" ]; then
    batt_values_buf="${batt_at}"; i="0"
    while [ "${batt_values_buf}" ]; do
        batt_value="${batt_values_buf%%,*}"; i="$((${i}+1))"
        if [ "${batt_current}" -lt "${batt_value}" ]; then
            case "${i}" in
                1)  # Battery in the latest valid value -> force to take action
                    _notify "Critical" "battery under ${batt_value}%, the system will hibernate in 30 seconds, unless you plugin the computer"
                    j=0 ; while [ "${j}" -lt "30" ]; do
                        sleep 1
                        stat="$(acpi -b | awk '{sub(",", ""); print $3}')"
                        if [ X"${stat}" != X"Discharging" ]; then
                            _notify  "Charging" "charging now..."
                            break
                        fi
                        j="$((${j} + 1))"
                    done

                    #check for the last time if someone has pluged in the machine
                    stat="$(acpi -b | awk '{sub(",", ""); print $3}')"

                    if [ X"${stat}" = X"Discharging" ]; then
                        [ -x "$(command -v mpc)" ] && mpc stop
                        #a refusal (no swap to hibernate to, an inhibitor) or a menu still open a
                        #minute later ends in a power off, not in a dead battery; an inhibitor that
                        #stops that too is respected, and said
                        if ! _act ${action}; then
                            _notify "Critical" "${action} did not work, powering off: ${_act__error}"
                            _act systemctl poweroff || \
                                _notify "Critical" "the system cannot power off: ${_act__error}"
                        fi
                    fi
                    ;;
                *)
                    [ X"${batt_last_seen}" = X"${batt_value}" ] && exit 0
                    _notify  "Warning" "battery under ${batt_value}%"
                    batt_last_seen="${batt_value}"
                    ;;
            esac
            printf "%s\\n" "${batt_last_seen}" > "${rundir}/${PROGNAME}".last
            break
        fi
        [ X"${batt_values_buf}" = X"${batt_value}" ] && batt_values_buf='' || batt_values_buf="${batt_values_buf#*,}"
    done
fi
