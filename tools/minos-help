#!/bin/sh
#description: show shortcut information in minos
#usage: minos-help

progname="$(expr "${0}" : '.*/\([^/]*\)')"

_usage() {
    printf "%s\\n" "Usage: ${progname} [options]"
    printf "%s\\n" "Minos help window."
    printf "\\n"
    printf "%s\\n" "  -h, --help   show this help message and exit"
}

_die() {
    [ -z "${1}" ] || printf "%s\\n" "${*}" >&2
    _usage >&2; exit 1
}

_whereis() {
    [ -z "${1}" ] && return 1
    if ! command -v "${1}" 2>/dev/null; then
        return 1
    fi
}

if [ ! -t 0 ]; then
    #there is input comming from pipe or file, add to the end of $@
    set -- "${@}" $(cat)
fi

for arg; do #parse options
    case "${arg}" in
        --) shift; break  ;;
        -h|--help) _usage && exit ;;
        -*) _die "${progname}: unrecognized option '${arg}'" ;;
    esac
done

running="$(ps aux | awk '/got it/ {if ($0 !~ "awk") print $2}')"
[ -n "${running}" ] && exit 1

#the help file, or the words saying there is none, given as the message itself
if [ -f "${HOME}"/.minos/help ]; then
    set -- -file "${HOME}"/.minos/help
elif [ -f "/etc/minos/help" ]; then
    set -- -file /etc/minos/help
else
    set -- 'No help available'
fi

if _whereis gxmessage >/dev/null; then
    gxmessage -geometry 400x520 -fn "Monaco 9" -buttons "got it" "${@}"
else #a core font paints Latin-1: UTF-8 takes Xaw's international mode and a fontset, a 13px font per charset
    LC_ALL=C.UTF-8 xmessage -xrm '*international: true' -xrm '*fontSet: -misc-fixed-medium-r-normal--13-*-*-*-*-*-*-*' -bg black -fg '#c7c1cc' -buttons "got it" "${@}"
fi
